{% extends "base.html.tera" %}

{% block subject %}Confirm your email to activate your GridTokenX account{% endblock subject %}
{% block title %}⚡ One Click to Activate{% endblock title %}
{% block subtitle %}Confirm your email to start trading energy{% endblock subtitle %}

{% block content %}
                <p>Hello{% if name %} <strong>{{ name }}</strong>{% endif %},</p>
                <p>
                    Thanks for signing up for <strong>GridTokenX</strong> — the peer-to-peer
                    energy trading platform. Your account is almost ready: confirm this email
                    address to activate it and unlock sign-in, wallet linking, and trading.
                </p>
                <p style="text-align: center; margin: 32px 0;">
                    <a href="{{ verification_url }}" class="btn">✓ Verify My Email</a>
                </p>
                <p class="muted" style="text-align: center;">
                    One click — you'll be signed in automatically afterwards.
                </p>
                <div class="divider"></div>
                <p class="muted">
                    If the button doesn't work, copy and paste this link into your browser:
                </p>
                <div class="link-fallback"><a href="{{ verification_url }}" style="color: #059669; text-decoration: none;">{{ verification_url }}</a></div>
                <p class="muted" style="margin-top: 24px;">
                    You're receiving this because this address was used to register a GridTokenX
                    account. If that wasn't you, ignore this email — the account stays inactive
                    and no one can sign in with it.
                </p>
{% endblock content %}
