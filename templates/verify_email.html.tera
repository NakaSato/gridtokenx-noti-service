{% extends "base.html.tera" %}
{% import "_components.html.tera" as ui %}

{% block subject %}Confirm your email to activate your GridTokenX account{% endblock subject %}
{% block preheader %}One click to verify your email and activate your GridTokenX account.{% endblock preheader %}
{% block title %}Verify Your Email{% endblock title %}
{% block subtitle %}Confirm your email address to activate your account{% endblock subtitle %}

{% block extra_styles %}
        .verify-card {
            background-color: #f4f2fe;
            border: 1px solid #e5ddff;
            border-radius: 8px;
        }
        .verify-card td {
            padding: 28px;
            text-align: center;
        }
        .verify-card .badge {
            width: 56px;
            height: 56px;
            margin: 0 auto 16px;
            background-color: #e5ddff;
            color: #7b63f1;
            border-radius: 50%;
            font-size: 26px;
            font-weight: 700;
            line-height: 56px;
            text-align: center;
        }
        .verify-card p {
            margin: 0 0 20px;
            font-size: 15px;
            color: #333333;
        }
{% endblock extra_styles %}

{% block content %}
                <p>Hello{% if name %} <strong>{{ name }}</strong>{% endif %},</p>
                <p>
                    Thanks for signing up for <strong>GridTokenX</strong> — the peer-to-peer
                    energy trading platform. One last step: confirm this email address to
                    activate your account.
                </p>

                <table role="presentation" class="verify-card" width="100%" cellpadding="0" cellspacing="0" bgcolor="#f4f2fe" style="margin-bottom: 28px;">
                    <tr>
                        <td>
                            <div class="badge">&#10003;</div>
                            <p>Click below to verify your email. You'll be signed in automatically.</p>
                            <a href="{{ verification_url }}" class="btn" style="background-color: #7b63f1; background: linear-gradient(135deg, #7b63f1 0%, #a899f4 100%); padding: 16px 40px; font-size: 17px;">Verify My Email</a>
                        </td>
                    </tr>
                </table>

                <p class="section-label">What happens next</p>
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin-bottom: 24px;">
                    {{ ui::list_row(icon="1", text="Your account is activated instantly.") }}
                    {{ ui::list_row(icon="2", text="Link your Solana wallet for transactions.") }}
                    {{ ui::list_row(icon="3", text="Start trading renewable energy tokens (GRX).") }}
                </table>

                <div class="divider" style="margin: 24px 0;">&nbsp;</div>
                {{ ui::link_fallback(url=verification_url) }}

                <div class="box box-warn" style="margin-top: 24px;">
                    <p>
                        You're receiving this because this address was used to register a
                        GridTokenX account. If that wasn't you, ignore this email — the account
                        stays inactive and no one can sign in with it.
                    </p>
                </div>
{% endblock content %}
