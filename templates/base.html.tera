<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block subject %}GridTokenX{% endblock subject %}</title>
    <style>
        body {
            margin: 0;
            padding: 0;
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
            background-color: #f5f7fa;
            color: #333333;
            line-height: 1.6;
        }
        .email-wrapper {
            width: 100%;
            background-color: #f5f7fa;
            padding: 40px 0;
        }
        .email-container {
            max-width: 600px;
            margin: 0 auto;
            background-color: #ffffff;
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
        }
        .email-header {
            background: {% block header_gradient %}linear-gradient(135deg, #10b981 0%, #059669 100%){% endblock header_gradient %};
            padding: 32px 40px;
            text-align: center;
        }
        .email-header h1 {
            margin: 0;
            color: #ffffff;
            font-size: 24px;
            font-weight: 600;
        }
        .email-header p {
            margin: 8px 0 0;
            color: rgba(255, 255, 255, 0.9);
            font-size: 14px;
        }
        .email-body {
            padding: 40px;
        }
        .email-body p {
            margin: 0 0 20px;
            font-size: 16px;
            color: #4a5568;
        }
        .btn {
            display: inline-block;
            padding: 14px 32px;
            color: #ffffff;
            text-decoration: none;
            border-radius: 8px;
            font-size: 16px;
            font-weight: 600;
            text-align: center;
            background: {% block btn_gradient %}linear-gradient(135deg, #10b981 0%, #059669 100%){% endblock btn_gradient %};
        }
        .link-fallback {
            margin-top: 16px;
            padding: 16px;
            background-color: #f7fafc;
            border: 1px solid #e2e8f0;
            border-radius: 6px;
            font-size: 13px;
            color: #718096;
            word-break: break-all;
        }
        .divider {
            height: 1px;
            background-color: #e2e8f0;
            margin: 24px 0;
        }
        .muted {
            font-size: 14px;
            color: #718096;
        }
        .email-footer {
            padding: 24px 40px;
            background-color: #f7fafc;
            border-top: 1px solid #e2e8f0;
            text-align: center;
        }
        .email-footer p {
            margin: 0;
            font-size: 13px;
            color: #718096;
        }
        .email-footer .brand {
            font-weight: 600;
            color: #059669;
        }
        {% block extra_styles %}{% endblock extra_styles %}
    </style>
</head>
<body>
    <div class="email-wrapper">
        <div class="email-container">
            <div class="email-header">
                <h1>{% block title %}GridTokenX{% endblock title %}</h1>
                <p>{% block subtitle %}{% endblock subtitle %}</p>
            </div>
            <div class="email-body">
                {% block content %}{% endblock content %}
            </div>
            <div class="email-footer">
                <p>&copy; 2026 <span class="brand">GridTokenX</span>. All rights reserved.</p>
                <p style="margin-top: 8px;">This is an automated message. Please do not reply to this email.</p>
            </div>
        </div>
    </div>
</body>
</html>
