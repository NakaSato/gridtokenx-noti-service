<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="color-scheme" content="light">
    <meta name="supported-color-schemes" content="light">
    <title>{% block subject %}GridTokenX{% endblock subject %}</title>
    <style>
        /* Design tokens mirror the Trading UI (gridtokenx-trading app/globals.css,
           light-purple theme): primary #7b63f1, gradient #7b63f1 → #a899f4,
           foreground #17161b, secondary bg #f4f6f9, border #d1d8df, radius 8px,
           font TikTok Sans. Layout is table-based for broad email-client support
           (Outlook has no flexbox / CSS counters); the <style> block is
           progressive enhancement — load-bearing colors are repeated as
           bgcolor attributes. */
        @import url('https://fonts.googleapis.com/css2?family=TikTok+Sans:opsz,wght@12..36,300..900&display=swap');
        body {
            margin: 0;
            padding: 0;
            width: 100%;
            font-family: 'TikTok Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
            background-color: #f4f6f9;
            color: #17161b;
            line-height: 1.6;
            -webkit-text-size-adjust: 100%;
        }
        table {
            border-collapse: collapse;
        }
        img {
            border: 0;
            max-width: 100%;
        }
        .preheader {
            display: none;
            max-height: 0;
            overflow: hidden;
            font-size: 1px;
            line-height: 1px;
            color: #f4f6f9;
        }
        .email-container {
            width: 600px;
            max-width: 600px;
            background-color: #ffffff;
            border: 1px solid #d1d8df;
            border-radius: 8px;
            overflow: hidden;
        }
        .email-header {
            padding: 36px 40px 32px;
            text-align: center;
        }
        .brand-mark {
            margin: 0 0 14px;
            font-size: 13px;
            font-weight: 700;
            letter-spacing: 2px;
            text-transform: uppercase;
            color: rgba(255, 255, 255, 0.85);
        }
        .email-header h1 {
            margin: 0;
            color: #ffffff;
            font-size: 26px;
            font-weight: 700;
            letter-spacing: -0.3px;
        }
        .email-header .subtitle {
            margin: 10px 0 0;
            color: rgba(255, 255, 255, 0.88);
            font-size: 15px;
        }
        .email-body {
            padding: 40px;
        }
        .email-body p {
            margin: 0 0 20px;
            font-size: 16px;
            color: #333333;
        }
        .section-label {
            margin: 0 0 12px;
            font-size: 13px;
            font-weight: 700;
            letter-spacing: 1px;
            text-transform: uppercase;
            color: #7b63f1;
        }
        .btn {
            display: inline-block;
            padding: 14px 36px;
            color: #ffffff !important;
            text-decoration: none;
            border-radius: 8px;
            font-size: 16px;
            font-weight: 600;
            text-align: center;
        }
        .link-fallback {
            margin: 0;
            padding: 14px 16px;
            background-color: #f4f6f9;
            border: 1px solid #d1d8df;
            border-radius: 8px;
            font-size: 13px;
            color: #808693;
            word-break: break-all;
        }
        .divider {
            height: 1px;
            line-height: 1px;
            font-size: 0;
            background-color: #d1d8df;
        }
        .muted {
            font-size: 14px;
            color: #808693;
        }
        /* Informational callouts */
        .box {
            border-radius: 8px;
            padding: 14px 16px;
            font-size: 13px;
        }
        .box p {
            margin: 0;
            font-size: 13px;
        }
        .box-info {
            background-color: #f4f2fe;
            border: 1px solid #e5ddff;
            color: #4c3daf;
        }
        .box-info p { color: #4c3daf; }
        .box-warn {
            background-color: #fffbeb;
            border: 1px solid #fde68a;
            border-left: 4px solid #f1c40f;
            color: #92400e;
        }
        .box-warn p { color: #92400e; }
        /* Icon-bullet lists (rendered as table rows, not flex) */
        .list-icon {
            width: 26px;
            height: 26px;
            border-radius: 50%;
            background-color: #e5ddff;
            color: #7b63f1;
            font-size: 13px;
            font-weight: 700;
            text-align: center;
            vertical-align: middle;
        }
        .list-text {
            padding: 7px 0 7px 12px;
            font-size: 15px;
            color: #333333;
        }
        .email-footer {
            padding: 26px 40px;
            background-color: #f4f6f9;
            border-top: 1px solid #d1d8df;
            text-align: center;
        }
        .email-footer p {
            margin: 0;
            font-size: 13px;
            color: #808693;
        }
        .email-footer .brand {
            font-weight: 700;
            color: #7b63f1;
        }
        @media only screen and (max-width: 620px) {
            .email-container {
                width: 100% !important;
                border-radius: 0 !important;
            }
            .email-header,
            .email-body,
            .email-footer {
                padding-left: 24px !important;
                padding-right: 24px !important;
            }
            .btn {
                display: block !important;
            }
        }
        {% block extra_styles %}{% endblock extra_styles %}
    </style>
</head>
<body>
    <div class="preheader">{% block preheader %}{% endblock preheader %}</div>
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" bgcolor="#f4f6f9">
        <tr>
            <td align="center" style="padding: 40px 16px;">
                <table role="presentation" class="email-container" width="600" cellpadding="0" cellspacing="0" bgcolor="#ffffff">
                    <tr>
                        <td class="email-header" bgcolor="{% block header_bg %}#7b63f1{% endblock header_bg %}"
                            style="background: {% block header_gradient %}linear-gradient(135deg, #7b63f1 0%, #a899f4 100%){% endblock header_gradient %};">
                            <p class="brand-mark">&#9889; GridTokenX</p>
                            <h1>{% block title %}GridTokenX{% endblock title %}</h1>
                            <p class="subtitle">{% block subtitle %}{% endblock subtitle %}</p>
                        </td>
                    </tr>
                    <tr>
                        <td class="email-body">
                            {% block content %}{% endblock content %}
                        </td>
                    </tr>
                    <tr>
                        <td class="email-footer">
                            <p>&copy; 2026 <span class="brand">GridTokenX</span>. All rights reserved.</p>
                            <p style="margin-top: 8px;">This is an automated message. Please do not reply to this email.</p>
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>
</body>
</html>
