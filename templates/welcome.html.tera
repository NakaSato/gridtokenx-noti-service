{% extends "base.html.tera" %}
{% import "_components.html.tera" as ui %}

{% block subject %}Welcome to GridTokenX{% endblock subject %}
{% block preheader %}Your account is active — start trading peer-to-peer energy on Solana.{% endblock preheader %}
{% block title %}Welcome to GridTokenX!{% endblock title %}
{% block subtitle %}Your gateway to decentralized energy trading{% endblock subtitle %}

{% block content %}
                <p>Hello{% if name %} <strong>{{ name }}</strong>{% endif %},</p>
                <p>
                    Your email is verified and your <strong>GridTokenX</strong> account is now active.
                    You're part of the future of peer-to-peer energy trading powered by the Solana blockchain.
                </p>

                <p class="section-label">Here's what you can do</p>
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin-bottom: 28px;">
                    {{ ui::list_row(icon="✓", text="Trade renewable energy tokens (GRX) on the marketplace") }}
                    {{ ui::list_row(icon="✓", text="Earn Renewable Energy Certificates (ERCs) for green contributions") }}
                    {{ ui::list_row(icon="✓", text="Connect smart meters to track on-chain energy generation") }}
                    {{ ui::list_row(icon="✓", text="Link your Solana wallet for seamless transactions") }}
                </table>

                {{ ui::button(url=dashboard_url | default(value="https://app.gridtokenx.xyz"), label="Launch Dashboard") }}
{% endblock content %}
