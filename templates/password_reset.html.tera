<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <style>
        body {
            margin: 0;
            padding: 0;
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
            background-color: #f5f7fa;
            color: #333333;
            line-height: 1.6;
        }
        .email-wrapper {
            width: 100%;
            background-color: #f5f7fa;
            padding: 40px 0;
        }
        .email-container {
            max-width: 600px;
            margin: 0 auto;
            background-color: #ffffff;
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
        }
        .email-header {
            background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
            padding: 32px 40px;
            text-align: center;
        }
        .email-header h1 {
            margin: 0;
            color: #ffffff;
            font-size: 24px;
            font-weight: 600;
        }
        .email-header p {
            margin: 8px 0 0;
            color: rgba(255, 255, 255, 0.9);
            font-size: 14px;
        }
        .email-body {
            padding: 40px;
        }
        .email-body p {
            margin: 0 0 20px;
            font-size: 16px;
            color: #4a5568;
        }
        .reset-button {
            display: inline-block;
            padding: 14px 32px;
            background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
            color: #ffffff;
            text-decoration: none;
            border-radius: 8px;
            font-size: 16px;
            font-weight: 600;
            text-align: center;
            margin: 8px 0 24px;
        }
        .reset-button:hover {
            background: linear-gradient(135deg, #d97706 0%, #b45309 100%);
        }
        .reset-link-fallback {
            margin-top: 16px;
            padding: 16px;
            background-color: #f7fafc;
            border: 1px solid #e2e8f0;
            border-radius: 6px;
            font-size: 13px;
            color: #718096;
            word-break: break-all;
        }
        .divider {
            height: 1px;
            background-color: #e2e8f0;
            margin: 24px 0;
        }
        .warning-box {
            background-color: #fffbeb;
            border: 1px solid #fde68a;
            border-radius: 8px;
            padding: 16px;
            margin: 20px 0 0;
        }
        .warning-box p {
            margin: 0;
            font-size: 14px;
            color: #92400e;
        }
        .email-footer {
            padding: 24px 40px;
            background-color: #f7fafc;
            border-top: 1px solid #e2e8f0;
            text-align: center;
        }
        .email-footer p {
            margin: 0;
            font-size: 13px;
            color: #718096;
        }
        .email-footer .brand {
            font-weight: 600;
            color: #059669;
        }
    </style>
</head>
<body>
    <div class="email-wrapper">
        <div class="email-container">
            <div class="email-header">
                <h1>🔑 Reset Your Password</h1>
                <p>GridTokenX Account Recovery</p>
            </div>
            <div class="email-body">
                <p>Hello,</p>
                <p>
                    We received a request to reset the password for your
                    <strong>GridTokenX</strong> account. Click the button below
                    to choose a new password:
                </p>
                <p style="text-align: center;">
                    <a href="{{ reset_url }}" class="reset-button">
                        Reset Password
                    </a>
                </p>
                <div class="divider"></div>
                <p style="font-size: 14px; color: #718096;">
                    If the button above doesn't work, copy and paste this link into your browser:
                </p>
                <div class="reset-link-fallback">
                    {{ reset_url }}
                </div>
                <div class="warning-box">
                    <p>⚠️ If you did not request a password reset, please ignore this email. Your password will remain unchanged.</p>
                </div>
            </div>
            <div class="email-footer">
                <p>&copy; 2026 <span class="brand">GridTokenX</span>. All rights reserved.</p>
                <p style="margin-top: 8px;">This is an automated message. Please do not reply to this email.</p>
            </div>
        </div>
    </div>
</body>
</html>
