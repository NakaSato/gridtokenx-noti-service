{% extends "base.html.tera" %}
{% import "_components.html.tera" as ui %}

{% block subject %}Reset your GridTokenX password{% endblock subject %}
{% block preheader %}Choose a new password for your GridTokenX account.{% endblock preheader %}
{% block title %}Reset Your Password{% endblock title %}
{% block subtitle %}GridTokenX Account Recovery{% endblock subtitle %}

{# Warning-amber accent (Trading UI warning token) — signals a security action. #}
{% block header_bg %}#d97706{% endblock header_bg %}
{% block header_gradient %}linear-gradient(135deg, #f1c40f 0%, #d97706 100%){% endblock header_gradient %}

{% block content %}
                <p>Hello,</p>
                <p>
                    We received a request to reset the password for your
                    <strong>GridTokenX</strong> account. Click the button below
                    to choose a new password:
                </p>

                {{ ui::button(url=reset_url, label="Reset Password", bg="#d97706", gradient="linear-gradient(135deg, #f1c40f 0%, #d97706 100%)") }}

                <div class="divider" style="margin: 24px 0;">&nbsp;</div>
                {{ ui::link_fallback(url=reset_url, accent="#d97706") }}

                <div class="box box-warn" style="margin-top: 24px;">
                    <p>
                        &#9888;&#65039; If you did not request a password reset, please ignore
                        this email. Your password will remain unchanged.
                    </p>
                </div>
{% endblock content %}
