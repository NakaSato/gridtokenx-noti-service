# gridtokenx-noti-service — environment template
# Copy to .env for local dev:  cp .env.example .env
# Loaded via dotenvy + config crate (RUN_MODE selects config/{mode} overlay).

# --- Runtime ---
RUN_MODE=development
LOG_LEVEL=info

# --- Ports ---
PORT=8080                 # HTTP/REST
GRPC_PORT=8090            # ConnectRPC (defaults to PORT+10 if unset)

# --- Persistence (REQUIRED) ---
DATABASE_URL=postgresql://gridtokenx_user:gridtokenx_password@localhost:7001/gridtokenx_noti
REDIS_URL=redis://localhost:7010

# Database pooling (optional — defaults shown)
DATABASE_MAX_CONNECTIONS=20
DATABASE_MIN_CONNECTIONS=5
DATABASE_ACQUIRE_TIMEOUT_SECS=30
DATABASE_IDLE_TIMEOUT_SECS=600

# --- Messaging (REQUIRED) ---
KAFKA_BROKERS=localhost:29001
RABBITMQ_URL=amqp://gridtokenx:rabbitmq_secret_2025@localhost:9030/%2f

# Kafka topics (optional — defaults shown)
KAFKA_TOPIC_USER_EVENTS=iam.user.events
KAFKA_TOPIC_AUDIT_EVENTS=iam.audit.events
# Trading price-alert firings (matches trading EventBus `{KAFKA_TOPIC_PREFIX}.triggers`)
KAFKA_TOPIC_TRADING_TRIGGERS=trading.triggers

# --- Auth (REQUIRED) ---
JWT_SECRET=change-me-in-prod-min-32-chars-long-secret

# --- Email / SMTP (optional — unset SMTP_HOST → MockEmailProvider) ---
# Local dev: Mailpit. Web UI at http://localhost:13060
# Use 'mailpit' as host if noti runs inside the compose network
SMTP_HOST=localhost
SMTP_PORT=1025
# SMTP_TLS_MODE: none (Mailpit) | starttls | tls(465)
SMTP_TLS_MODE=none
SMTP_FROM=noreply@gridtokenx.local
# SMTP_USER=
# SMTP_PASS=

# --- Frontend (optional — email callback links) ---
FRONTEND_URL=http://localhost:3000

# --- SMS (optional — reserved; MockSmsProvider until implemented) ---
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=

# --- Push (optional — reserved; MockPushProvider until implemented) ---
# FCM_PROJECT_ID=
